{
  "name": "texdown",
  "displayName": "TeXdown Preview",
  "description": "Preview LaTeX like Markdown: math, sections and numbered theorems with working references, live as you type. No TeX installation needed.",
  "version": "0.2.0",
  "publisher": "klepo0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/klepo0/TeXdown"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "latex",
    "tex",
    "preview",
    "katex",
    "math",
    "github.dev",
    "vscode.dev"
  ],
  "main": "./extension.js",
  "browser": "./dist/web.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex",
    "onWebviewPanel:texdown.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "texdown.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "TeXdown",
        "icon": "$(open-preview)"
      },
      {
        "command": "texdown.openPreview",
        "title": "Open Preview",
        "category": "TeXdown"
      },
      {
        "command": "texdown.disableScrollSync",
        "title": "Stop Scrolling with the Editor",
        "category": "TeXdown",
        "icon": "$(link)"
      },
      {
        "command": "texdown.enableScrollSync",
        "title": "Scroll with the Editor",
        "category": "TeXdown",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "texdown.toggleScrollSync",
        "title": "Toggle Scrolling with the Editor",
        "category": "TeXdown"
      },
      {
        "command": "texdown.toggleContents",
        "title": "Show or Hide Contents",
        "category": "TeXdown",
        "icon": "$(list-tree)"
      },
      {
        "command": "texdown.hideProofs",
        "title": "Hide Proofs",
        "category": "TeXdown",
        "icon": "$(fold)"
      },
      {
        "command": "texdown.showProofs",
        "title": "Show Proofs",
        "category": "TeXdown",
        "icon": "$(unfold)"
      },
      {
        "command": "texdown.toggleTheme",
        "title": "Toggle Light/Dark Preview",
        "category": "TeXdown",
        "icon": "$(color-mode)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "texdown.openPreviewToSide",
          "when": "resourceLangId == latex || resourceLangId == tex || resourceExtname == .tex",
          "group": "navigation"
        },
        {
          "command": "texdown.toggleContents",
          "when": "activeWebviewPanelId == 'texdown.preview'",
          "group": "navigation@1"
        },
        {
          "command": "texdown.hideProofs",
          "when": "activeWebviewPanelId == 'texdown.preview' && texdown.hasProofs && !texdown.proofsFolded",
          "group": "navigation@2"
        },
        {
          "command": "texdown.showProofs",
          "when": "activeWebviewPanelId == 'texdown.preview' && texdown.hasProofs && texdown.proofsFolded",
          "group": "navigation@2"
        },
        {
          "command": "texdown.toggleTheme",
          "when": "activeWebviewPanelId == 'texdown.preview'",
          "group": "navigation@3"
        },
        {
          "command": "texdown.disableScrollSync",
          "when": "activeWebviewPanelId == 'texdown.preview' && config.texdown.scrollSync",
          "group": "navigation@3"
        },
        {
          "command": "texdown.enableScrollSync",
          "when": "activeWebviewPanelId == 'texdown.preview' && !config.texdown.scrollSync",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "texdown.openPreview",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "texdown.disableScrollSync",
          "when": "false"
        },
        {
          "command": "texdown.enableScrollSync",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "texdown.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == latex || editorLangId == tex || resourceExtname == .tex"
      }
    ],
    "configuration": {
      "title": "TeXdown",
      "properties": {
        "texdown.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Scroll the preview along with the editor, and the editor along with the preview."
        },
        "texdown.previewTheme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow VS Code's colour theme.",
            "Always light.",
            "Always dark."
          ],
          "default": "auto",
          "description": "Colours of the preview. The button in the preview's title bar switches between light and dark."
        }
      }
    }
  },
  "scripts": {
    "copy-shared": "node scripts/copy-shared.js",
    "vscode:prepublish": "node scripts/build-web.js --minify",
    "package": "vsce package",
    "test": "node --test test/*.test.js",
    "build-web": "node scripts/build-web.js --minify",
    "test-web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. test/fixtures/web"
  },
  "dependencies": {
    "katex": "0.16.11"
  },
  "devDependencies": {
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.10",
    "path-browserify": "^1.0.1"
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
