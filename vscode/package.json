{
  "name": "texglass",
  "displayName": "TeXglass Preview",
  "description": "Preview LaTeX like Markdown: math, sections and numbered theorems with working references, live as you type. No TeX installation needed.",
  "version": "0.8.0",
  "publisher": "klepo1",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1d3478",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/klepo0/TeXglass"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "latex",
    "tex",
    "preview",
    "katex",
    "math",
    "github.dev",
    "vscode.dev"
  ],
  "main": "./extension.js",
  "browser": "./dist/web.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex",
    "onWebviewPanel:texglass.preview",
    "onCommand:texglass.exportHtml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "texglass.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "TeXglass",
        "icon": "$(open-preview)"
      },
      {
        "command": "texglass.openPreview",
        "title": "Open Preview",
        "category": "TeXglass"
      },
      {
        "command": "texglass.disableScrollSync",
        "title": "Stop Scrolling with the Editor",
        "category": "TeXglass",
        "icon": "$(link)"
      },
      {
        "command": "texglass.enableScrollSync",
        "title": "Scroll with the Editor",
        "category": "TeXglass",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "texglass.toggleScrollSync",
        "title": "Toggle Scrolling with the Editor",
        "category": "TeXglass"
      },
      {
        "command": "texglass.toggleContents",
        "title": "Show or Hide Contents",
        "category": "TeXglass",
        "icon": "$(list-tree)"
      },
      {
        "command": "texglass.hideProofs",
        "title": "Hide Proofs",
        "category": "TeXglass",
        "icon": "$(fold)"
      },
      {
        "command": "texglass.showProofs",
        "title": "Show Proofs",
        "category": "TeXglass",
        "icon": "$(unfold)"
      },
      {
        "command": "texglass.toggleTheme",
        "title": "Toggle Light/Dark Preview",
        "category": "TeXglass",
        "icon": "$(color-mode)"
      },
      {
        "command": "texglass.find",
        "title": "Find in Preview",
        "category": "TeXglass",
        "icon": "$(search)"
      },
      {
        "command": "texglass.goTo",
        "title": "Go to Theorem, Equation or Section…",
        "category": "TeXglass"
      },
      {
        "command": "texglass.findNext",
        "title": "Find Next in Preview",
        "category": "TeXglass"
      },
      {
        "command": "texglass.findPrevious",
        "title": "Find Previous in Preview",
        "category": "TeXglass"
      },
      {
        "command": "texglass.exportHtml",
        "title": "Export to HTML",
        "category": "TeXglass",
        "icon": "$(export)"
      },
      {
        "command": "texglass.print",
        "title": "Print / Save as PDF",
        "category": "TeXglass",
        "icon": "$(printer)"
      },
      {
        "command": "texglass.zoomIn",
        "title": "Zoom In",
        "category": "TeXglass",
        "icon": "$(zoom-in)"
      },
      {
        "command": "texglass.zoomOut",
        "title": "Zoom Out",
        "category": "TeXglass",
        "icon": "$(zoom-out)"
      },
      {
        "command": "texglass.resetZoom",
        "title": "Reset Zoom",
        "category": "TeXglass"
      },
      {
        "command": "texglass.toggleContentsPosition",
        "title": "Move Contents to the Other Side",
        "category": "TeXglass"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "texglass.openPreviewToSide",
          "when": "resourceLangId == latex || resourceLangId == tex || resourceExtname == .tex",
          "group": "navigation"
        },
        {
          "command": "texglass.find",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "navigation@0"
        },
        {
          "command": "texglass.toggleContents",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "navigation@1"
        },
        {
          "command": "texglass.hideProofs",
          "when": "activeWebviewPanelId == 'texglass.preview' && texglass.hasProofs && !texglass.proofsFolded",
          "group": "navigation@2"
        },
        {
          "command": "texglass.showProofs",
          "when": "activeWebviewPanelId == 'texglass.preview' && texglass.hasProofs && texglass.proofsFolded",
          "group": "navigation@2"
        },
        {
          "command": "texglass.toggleTheme",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "navigation@3"
        },
        {
          "command": "texglass.disableScrollSync",
          "when": "activeWebviewPanelId == 'texglass.preview' && config.texglass.scrollSync",
          "group": "navigation@3"
        },
        {
          "command": "texglass.enableScrollSync",
          "when": "activeWebviewPanelId == 'texglass.preview' && !config.texglass.scrollSync",
          "group": "navigation@3"
        },
        {
          "command": "texglass.exportHtml",
          "when": "activeWebviewPanelId == 'texglass.preview' || resourceLangId == latex || resourceLangId == tex || resourceExtname == .tex",
          "group": "1_texglass"
        },
        {
          "command": "texglass.print",
          "when": "activeWebviewPanelId == 'texglass.preview' || resourceLangId == latex || resourceLangId == tex || resourceExtname == .tex",
          "group": "1_texglass"
        },
        {
          "command": "texglass.zoomIn",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "0_zoom@1"
        },
        {
          "command": "texglass.zoomOut",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "0_zoom@2"
        },
        {
          "command": "texglass.resetZoom",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "0_zoom@3"
        },
        {
          "command": "texglass.toggleContentsPosition",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "0_zoom@4"
        }
      ],
      "explorer/context": [
        {
          "command": "texglass.openPreview",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        },
        {
          "command": "texglass.exportHtml",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        },
        {
          "command": "texglass.print",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "texglass.disableScrollSync",
          "when": "false"
        },
        {
          "command": "texglass.enableScrollSync",
          "when": "false"
        },
        {
          "command": "texglass.find",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.goTo",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.findNext",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.findPrevious",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.zoomIn",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.zoomOut",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.resetZoom",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.toggleContentsPosition",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "texglass.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == latex || editorLangId == tex || resourceExtname == .tex"
      },
      {
        "command": "texglass.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.goTo",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.findNext",
        "key": "f3",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.findPrevious",
        "key": "shift+f3",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomOut",
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.resetZoom",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.resetZoom",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      }
    ],
    "configuration": {
      "title": "TeXglass",
      "properties": {
        "texglass.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Scroll the preview along with the editor, and the editor along with the preview."
        },
        "texglass.previewTheme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow VS Code's colour theme.",
            "Always light.",
            "Always dark."
          ],
          "default": "auto",
          "description": "Colours of the preview. The button in the preview's title bar switches between light and dark."
        },
        "texglass.contentsPosition": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "Contents on the left of the document.",
            "Contents on the right of the document."
          ],
          "default": "left",
          "description": "Which side of the preview the table of contents is on. The button at the top of the contents switches sides."
        },
        "texglass.exportEmbedFonts": {
          "type": "boolean",
          "default": true,
          "description": "Put KaTeX's stylesheet and fonts (about 350 KB) inside pages made with Export to HTML, so their math looks right offline. Turn off to load them from a CDN instead and keep the files small."
        }
      }
    }
  },
  "scripts": {
    "copy-shared": "node scripts/copy-shared.js",
    "vscode:prepublish": "node scripts/build-web.js --minify",
    "package": "vsce package",
    "test": "node --test test/*.test.js",
    "build-web": "node scripts/build-web.js --minify",
    "test-web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. test/fixtures/web"
  },
  "dependencies": {
    "katex": "0.16.11"
  },
  "devDependencies": {
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.10",
    "path-browserify": "^1.0.1"
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
