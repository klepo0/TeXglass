{
  "name": "texdown",
  "displayName": "TeXdown Preview",
  "description": "Preview LaTeX like Markdown: math, sections and numbered theorems with working references, live as you type. No TeX installation needed.",
  "version": "0.1.0",
  "publisher": "klepo0",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/klepo0/TeXdown" },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Visualization"],
  "keywords": ["latex", "tex", "preview", "katex", "math"],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex",
    "onWebviewPanel:texdown.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "texdown.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "TeXdown",
        "icon": "$(open-preview)"
      },
      {
        "command": "texdown.openPreview",
        "title": "Open Preview",
        "category": "TeXdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "texdown.openPreviewToSide",
          "when": "resourceLangId == latex || resourceLangId == tex || resourceExtname == .tex",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "texdown.openPreview",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "texdown.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == latex || editorLangId == tex || resourceExtname == .tex"
      }
    ],
    "configuration": {
      "title": "TeXdown",
      "properties": {
        "texdown.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Scroll the preview along with the editor, and the editor along with the preview."
        }
      }
    }
  },
  "scripts": {
    "copy-shared": "node scripts/copy-shared.js",
    "vscode:prepublish": "node scripts/copy-shared.js",
    "package": "vsce package",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "katex": "0.16.11"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
