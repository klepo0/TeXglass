{
  "name": "texglass",
  "displayName": "TeXglass Preview",
  "description": "Preview LaTeX like Markdown: math, sections and numbered theorems with working references, live as you type. No TeX installation needed.",
  "version": "0.18.2",
  "publisher": "klepo1",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1d3478",
    "theme": "dark"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/klepo0/TeXglass"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "latex",
    "tex",
    "preview",
    "katex",
    "math",
    "github.dev",
    "vscode.dev"
  ],
  "main": "./extension.js",
  "browser": "./dist/web.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex",
    "onWebviewPanel:texglass.preview",
    "onCommand:texglass.exportHtml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "texglass.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "TeXglass",
        "icon": "$(open-preview)"
      },
      {
        "command": "texglass.openPreview",
        "title": "Open Preview",
        "category": "TeXglass"
      },
      {
        "command": "texglass.showCursor",
        "title": "Jump Preview to Cursor",
        "category": "TeXglass",
        "icon": "$(target)"
      },
      {
        "command": "texglass.disableScrollSync",
        "title": "Stop Scrolling with the Editor",
        "category": "TeXglass",
        "icon": "$(link)"
      },
      {
        "command": "texglass.enableScrollSync",
        "title": "Scroll with the Editor",
        "category": "TeXglass",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "texglass.toggleScrollSync",
        "title": "Toggle Scrolling with the Editor",
        "category": "TeXglass"
      },
      {
        "command": "texglass.toggleContents",
        "title": "Show or Hide Contents",
        "category": "TeXglass",
        "icon": "$(list-tree)"
      },
      {
        "command": "texglass.hideProofs",
        "title": "Hide Proofs",
        "category": "TeXglass",
        "icon": "$(fold)"
      },
      {
        "command": "texglass.showProofs",
        "title": "Show Proofs",
        "category": "TeXglass",
        "icon": "$(unfold)"
      },
      {
        "command": "texglass.toggleTheme",
        "title": "Toggle Light/Dark Preview",
        "category": "TeXglass",
        "icon": "$(color-mode)"
      },
      {
        "command": "texglass.toggleHandwriting",
        "title": "Toggle Handwritten Notes Look",
        "category": "TeXglass",
        "icon": "$(edit)"
      },
      {
        "command": "texglass.toggleStudyTools",
        "title": "Show or Hide Highlights and Notes",
        "category": "TeXglass"
      },
      {
        "command": "texglass.nextMarginNote",
        "title": "Next Margin Note",
        "category": "TeXglass"
      },
      {
        "command": "texglass.previousMarginNote",
        "title": "Previous Margin Note",
        "category": "TeXglass"
      },
      {
        "command": "texglass.exportNotes",
        "title": "Export Highlights and Notes…",
        "category": "TeXglass"
      },
      {
        "command": "texglass.importNotes",
        "title": "Import Highlights and Notes…",
        "category": "TeXglass"
      },
      {
        "command": "texglass.syncNotes",
        "title": "Sync Highlights and Notes with GitHub",
        "category": "TeXglass"
      },
      {
        "command": "texglass.stopSyncingNotes",
        "title": "Stop Syncing Highlights and Notes with GitHub",
        "category": "TeXglass"
      },
      {
        "command": "texglass.find",
        "title": "Find in Preview",
        "category": "TeXglass",
        "icon": "$(search)"
      },
      {
        "command": "texglass.goTo",
        "title": "Go to Theorem, Equation or Section…",
        "category": "TeXglass"
      },
      {
        "command": "texglass.showNotation",
        "title": "Show Notation Index",
        "category": "TeXglass"
      },
      {
        "command": "texglass.showDependencies",
        "title": "Show Dependency Map of the Results",
        "category": "TeXglass"
      },
      {
        "command": "texglass.showLargerMap",
        "title": "Show Larger Dependency Map",
        "category": "TeXglass"
      },
      {
        "command": "texglass.findNext",
        "title": "Find Next in Preview",
        "category": "TeXglass"
      },
      {
        "command": "texglass.findPrevious",
        "title": "Find Previous in Preview",
        "category": "TeXglass"
      },
      {
        "command": "texglass.exportHtml",
        "title": "Export to HTML",
        "category": "TeXglass",
        "icon": "$(export)"
      },
      {
        "command": "texglass.print",
        "title": "Print / Save as PDF",
        "category": "TeXglass",
        "icon": "$(printer)"
      },
      {
        "command": "texglass.zoomIn",
        "title": "Zoom In",
        "category": "TeXglass",
        "icon": "$(zoom-in)"
      },
      {
        "command": "texglass.zoomOut",
        "title": "Zoom Out",
        "category": "TeXglass",
        "icon": "$(zoom-out)"
      },
      {
        "command": "texglass.resetZoom",
        "title": "Reset Zoom",
        "category": "TeXglass"
      },
      {
        "command": "texglass.toggleContentsPosition",
        "title": "Move Contents to the Other Side",
        "category": "TeXglass"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "texglass.openPreviewToSide",
          "when": "resourceLangId == latex || resourceLangId == tex || resourceExtname == .tex",
          "group": "navigation"
        },
        {
          "command": "texglass.find",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "navigation@0"
        },
        {
          "command": "texglass.showNotation",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "4_insight@1"
        },
        {
          "command": "texglass.showDependencies",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "4_insight@2"
        },
        {
          "command": "texglass.toggleContents",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "navigation@1"
        },
        {
          "command": "texglass.hideProofs",
          "when": "activeWebviewPanelId == 'texglass.preview' && texglass.hasProofs && !texglass.proofsFolded",
          "group": "navigation@2"
        },
        {
          "command": "texglass.showProofs",
          "when": "activeWebviewPanelId == 'texglass.preview' && texglass.hasProofs && texglass.proofsFolded",
          "group": "navigation@2"
        },
        {
          "command": "texglass.toggleHandwriting",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "navigation@3"
        },
        {
          "command": "texglass.toggleTheme",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "navigation@3"
        },
        {
          "command": "texglass.disableScrollSync",
          "when": "activeWebviewPanelId == 'texglass.preview' && config.texglass.scrollSync",
          "group": "navigation@3"
        },
        {
          "command": "texglass.enableScrollSync",
          "when": "activeWebviewPanelId == 'texglass.preview' && !config.texglass.scrollSync",
          "group": "navigation@3"
        },
        {
          "command": "texglass.exportHtml",
          "when": "activeWebviewPanelId == 'texglass.preview' || resourceLangId == latex || resourceLangId == tex || resourceExtname == .tex",
          "group": "1_texglass"
        },
        {
          "command": "texglass.print",
          "when": "activeWebviewPanelId == 'texglass.preview' || resourceLangId == latex || resourceLangId == tex || resourceExtname == .tex",
          "group": "1_texglass"
        },
        {
          "command": "texglass.zoomIn",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "0_zoom@1"
        },
        {
          "command": "texglass.zoomOut",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "0_zoom@2"
        },
        {
          "command": "texglass.resetZoom",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "0_zoom@3"
        },
        {
          "command": "texglass.toggleContentsPosition",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "0_zoom@4"
        },
        {
          "command": "texglass.toggleStudyTools",
          "when": "activeWebviewPanelId == 'texglass.preview'",
          "group": "0_look@1"
        },
        {
          "command": "texglass.exportNotes",
          "when": "activeWebviewPanelId == 'texglass.preview' && config.texglass.studyTools",
          "group": "5_notes@1"
        },
        {
          "command": "texglass.importNotes",
          "when": "activeWebviewPanelId == 'texglass.preview' && config.texglass.studyTools",
          "group": "5_notes@2"
        },
        {
          "command": "texglass.syncNotes",
          "when": "activeWebviewPanelId == 'texglass.preview' && config.texglass.studyTools",
          "group": "5_notes@3"
        }
      ],
      "explorer/context": [
        {
          "command": "texglass.openPreview",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        },
        {
          "command": "texglass.exportHtml",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        },
        {
          "command": "texglass.print",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "texglass.disableScrollSync",
          "when": "false"
        },
        {
          "command": "texglass.enableScrollSync",
          "when": "false"
        },
        {
          "command": "texglass.find",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.goTo",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.showNotation",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.showDependencies",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.showLargerMap",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.findNext",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.findPrevious",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.zoomIn",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.zoomOut",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.resetZoom",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.toggleContentsPosition",
          "when": "activeWebviewPanelId == 'texglass.preview'"
        },
        {
          "command": "texglass.showCursor",
          "when": "editorLangId == latex || editorLangId == tex || resourceExtname == .tex"
        }
      ],
      "editor/context": [
        {
          "command": "texglass.showCursor",
          "when": "editorLangId == latex || editorLangId == tex || resourceExtname == .tex",
          "group": "navigation@90"
        }
      ]
    },
    "keybindings": [
      {
        "command": "texglass.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == latex || editorLangId == tex || resourceExtname == .tex"
      },
      {
        "command": "texglass.showCursor",
        "key": "ctrl+k j",
        "mac": "cmd+k j",
        "when": "editorTextFocus && (editorLangId == latex || editorLangId == tex || resourceExtname == .tex)"
      },
      {
        "command": "texglass.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.goTo",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.findNext",
        "key": "f3",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.findPrevious",
        "key": "shift+f3",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomOut",
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.resetZoom",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      },
      {
        "command": "texglass.resetZoom",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "when": "activeWebviewPanelId == 'texglass.preview'"
      }
    ],
    "configuration": {
      "title": "TeXglass",
      "properties": {
        "texglass.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Scroll the preview along with the editor, and the editor along with the preview."
        },
        "texglass.studyTools": {
          "type": "boolean",
          "default": true,
          "description": "Highlight text and write notes in the preview's margin: select text for the highlighter bar, or drag the note pad (bottom right) onto a line. They are saved next to the .tex file, as name.texglass.json; the .tex itself is never changed. Export and import them with the TeXglass: Export/Import Highlights and Notes commands, and sync them between machines with TeXglass: Sync Highlights and Notes with GitHub (a private gist on your account); with VS Code's Settings Sync on, they also follow you to your other machines."
        },
        "texglass.notationHover": {
          "type": "boolean",
          "default": true,
          "description": "Rest the pointer on a formula in the preview to see where its notation is defined: the paper's own macros, and symbols defined with := ."
        },
        "texglass.clickToCopyMath": {
          "type": "boolean",
          "default": true,
          "description": "Click a formula in the preview to copy its LaTeX source. Double-click and Ctrl/Cmd+click still jump to the source."
        },
        "texglass.previewTheme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow VS Code's colour theme.",
            "Always light.",
            "Always dark."
          ],
          "default": "auto",
          "description": "Colours of the preview. The button in the preview's title bar switches between light and dark."
        },
        "texglass.previewStyle": {
          "type": "string",
          "enum": [
            "standard",
            "handwritten"
          ],
          "enumDescriptions": [
            "Typeset like a paper.",
            "Handwritten notes on a sheet of paper (chalk on a board in dark mode)."
          ],
          "default": "standard",
          "description": "How the preview looks. \"TeXglass: Toggle Handwritten Notes Look\" switches between the two."
        },
        "texglass.notes.paper": {
          "type": "string",
          "enum": [
            "grid",
            "lined",
            "plain"
          ],
          "enumDescriptions": [
            "Squared paper, like a maths exercise book.",
            "Ruled lines with a red margin.",
            "Blank paper."
          ],
          "default": "grid",
          "description": "The paper of the handwritten notes look."
        },
        "texglass.notes.handwriting": {
          "type": "string",
          "enum": [
            "kalam",
            "caveat",
            "patrick-hand",
            "architects-daughter"
          ],
          "enumDescriptions": [
            "Kalam: neat, rounded handwriting.",
            "Caveat: quick, slanted script.",
            "Patrick Hand: upright print.",
            "Architects Daughter: blocky draftsman lettering."
          ],
          "default": "kalam",
          "description": "The handwriting of the handwritten notes look, for text and for the letters and digits in formulas."
        },
        "texglass.notes.handwrittenMath": {
          "type": "boolean",
          "default": true,
          "description": "In the handwritten notes look, write the letters, digits and brackets in formulas by hand too. Symbols without a handwritten form (Greek letters, integrals, sums) keep KaTeX shapes in the same ink."
        },
        "texglass.notes.ink": {
          "type": "string",
          "enum": [
            "ballpoint",
            "fountain",
            "black"
          ],
          "enumDescriptions": [
            "Blue ballpoint.",
            "Royal-blue fountain pen: wetter ink that pools and soaks into the paper.",
            "Black ink."
          ],
          "default": "ballpoint",
          "description": "The pen of the handwritten notes look. In dark mode the notes are always chalk."
        },
        "texglass.notes.realisticInk": {
          "type": "boolean",
          "default": true,
          "description": "In the handwritten notes look, give strokes real ink: slightly ragged edges, ink that thins and pools along a line, and a little bleed into the paper (dusty chalk in dark mode). Turn off for flat, crisp ink. Printing and PDFs always use flat ink."
        },
        "texglass.contentsPosition": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "Contents on the left of the document.",
            "Contents on the right of the document."
          ],
          "default": "left",
          "description": "Which side of the preview the table of contents is on. The button at the top of the contents switches sides."
        },
        "texglass.exportEmbedFonts": {
          "type": "boolean",
          "default": true,
          "description": "Put KaTeX's stylesheet and fonts (about 350 KB) inside pages made with Export to HTML, so their math looks right offline. Turn off to load them from a CDN instead and keep the files small."
        }
      }
    }
  },
  "scripts": {
    "copy-shared": "node scripts/copy-shared.js",
    "vscode:prepublish": "node scripts/build-web.js --minify",
    "package": "vsce package",
    "package:dev": "node scripts/package-dev.js",
    "pretest": "node scripts/copy-shared.js",
    "test": "node --test test/*.test.js",
    "build-web": "node scripts/build-web.js --minify",
    "test-web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. test/fixtures/web"
  },
  "dependencies": {
    "katex": "0.16.11"
  },
  "devDependencies": {
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.10",
    "path-browserify": "^1.0.1"
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
